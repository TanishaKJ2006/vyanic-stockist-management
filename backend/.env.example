APP_NAME=Vyanic Stockist Management Portal
APP_ENV=development
# FastAPI listens on port 8000 by default; select the listening port in the uvicorn command.
# These are frontend origins, not backend addresses.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# MySQL credentials for the existing vyanic_stockist database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vyanic_stockist
MYSQL_USER=
MYSQL_PASSWORD=

# MongoDB connection. Use the URI provided for your local MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=vyanic_stockist

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30
